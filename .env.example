# Better Auth
BETTER_AUTH_SECRET=your-secret-key-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 (S3互換ストレージ - ローカル/Node環境用。Cloudflare Workers ランタイムでは binding を使用)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=kanoha-materials

# APIキーは x-goog-api-key ヘッダでのみ送信される(URLに載らない)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-1.5-flash
GEMINI_VISION_MODEL=gemini-1.5-flash
# 構造化出力(類題・ヒント再生成)。未設定なら GEMINI_TEXT_MODEL にフォールバック
GEMINI_STRUCTURED_MODEL=
# mock | gemini. 本番(NODE_ENV=production)では必須。未設定だと起動時にエラーになる(dev/test のみ mock に既定)
AI_PROVIDER_TEXT=mock

# 図解のAI画像生成(テンプレ不可 + 子どもの要求 + 親の許可 + コスト上限内のときのみ)。
# 未設定なら該当ルートが 503 を返す(テンプレ図解は動く)
OPENAI_API_KEY=
IMAGE_GENERATION_MODEL=

APP_URL=http://localhost:3000
MATERIAL_RETENTION_DAYS=30
DAILY_LEARNING_LIMIT_MINUTES=15
# 利用枠は AI呼び出し前に予約する(超過 429 / 不通 503)
AI_DAILY_COST_LIMIT_USD=2
AI_DAILY_CALL_LIMIT=100
AI_ANALYZE_COST_USD=0.01
AI_RECOGNIZE_COST_USD=0.005
AI_SIMILAR_COST_USD=0.005
AI_HINTS_COST_USD=0.002
AI_IMAGE_COST_USD=0.04
