# Better Auth
BETTER_AUTH_SECRET=your-secret-key-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 (S3互換ストレージ - ローカル/Node環境用)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=kanoha-materials

# Google Gemini / Imagen API (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_STRUCTURED_MODEL=gemini-2.5-flash

# 画像生成モデル (NanoBanana2 Lite: 最新・最速・最高コスパ)
IMAGE_GENERATION_MODEL=gemini-3.1-flash-lite-image

# mock | gemini
AI_PROVIDER_TEXT=mock

APP_URL=http://localhost:3000
MATERIAL_RETENTION_DAYS=30
DAILY_LEARNING_LIMIT_MINUTES=15

# 利用枠・コスト上限 (USD)
AI_DAILY_COST_LIMIT_USD=2
AI_DAILY_CALL_LIMIT=100
AI_ANALYZE_COST_USD=0.01
AI_RECOGNIZE_COST_USD=0.005
AI_SIMILAR_COST_USD=0.005
AI_HINTS_COST_USD=0.002
AI_ENGLISH_TALK_COST_USD=0.0005
AI_IMAGE_COST_USD=0.01
