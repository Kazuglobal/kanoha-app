{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sayuki",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sayuki-db",
      "database_id": "bf88781c-7269-4910-9300-e916d41a4932",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "kanoha-materials"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://sayuki.globalbunny.workers.dev",
    "NEXT_PUBLIC_APP_URL": "https://sayuki.globalbunny.workers.dev",
    "AI_PROVIDER_TEXT": "auto",
    "GEMINI_TEXT_MODEL": "gemini-2.5-flash",
    "GEMINI_VISION_MODEL": "gemini-2.5-flash",
    "GEMINI_STRUCTURED_MODEL": "gemini-2.5-flash",
    "IMAGE_GENERATION_MODEL": "gemini-3.1-flash-lite-image",
    "MATERIAL_RETENTION_DAYS": "30",
    "DAILY_LEARNING_LIMIT_MINUTES": "15",
    "AI_DAILY_COST_LIMIT_USD": "2",
    "AI_DAILY_CALL_LIMIT": "100",
    "AI_ANALYZE_COST_USD": "0.01",
    "AI_RECOGNIZE_COST_USD": "0.005",
    "AI_SIMILAR_COST_USD": "0.005",
    "AI_HINTS_COST_USD": "0.002",
    "AI_ENGLISH_TALK_COST_USD": "0.0005",
    "AI_IMAGE_COST_USD": "0.01",
    "GEMINI_TTS_MODEL": "gemini-2.5-flash-preview-tts"
  },
  "previews": {
    "vars": {
      "BETTER_AUTH_URL": "https://sayuki.globalbunny.workers.dev",
      "NEXT_PUBLIC_APP_URL": "https://sayuki.globalbunny.workers.dev",
      "AI_PROVIDER_TEXT": "auto",
      "GEMINI_TEXT_MODEL": "gemini-2.5-flash",
      "GEMINI_VISION_MODEL": "gemini-2.5-flash",
      "GEMINI_STRUCTURED_MODEL": "gemini-2.5-flash",
      "IMAGE_GENERATION_MODEL": "gemini-3.1-flash-lite-image",
      "MATERIAL_RETENTION_DAYS": "30",
      "DAILY_LEARNING_LIMIT_MINUTES": "15",
      "AI_DAILY_COST_LIMIT_USD": "2",
      "AI_DAILY_CALL_LIMIT": "100",
      "AI_ANALYZE_COST_USD": "0.01",
      "AI_RECOGNIZE_COST_USD": "0.005",
      "AI_SIMILAR_COST_USD": "0.005",
      "AI_HINTS_COST_USD": "0.002",
      "AI_ENGLISH_TALK_COST_USD": "0.0005",
      "AI_IMAGE_COST_USD": "0.01",
      "GEMINI_TTS_MODEL": "gemini-2.5-flash-preview-tts"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "bf88781c-7269-4910-9300-e916d41a4932"
      }
    ],
    "r2_buckets": [
      {
        "binding": "STORAGE",
        "bucket_name": "kanoha-materials"
      }
    ]
  }
}
