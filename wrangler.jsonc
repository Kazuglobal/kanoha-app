{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanoha-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kanoha-db",
      "database_id": "kanoha-db-binding"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "kanoha-materials"
    }
  ]
}
